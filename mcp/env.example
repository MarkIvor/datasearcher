# ── LLM (для classify_rows / generate_sql) ─────────────
# OpenAI-compatible API. Без LLM эти инструменты возвращают инструкцию для хоста.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen2.5:14b
# LLM_MODE=builtin

# ── Рендеринг графиков ─────────────────────────────────
# json | png | both
# DATASEARCHER_MCP_CHARTS_MODE=both

# ── Файл подключений ───────────────────────────────────
# DATASEARCHER_MCP_CONNECTIONS_FILE=connections.yaml

# ── Транспорт (http) ───────────────────────────────────
# DATASEARCHER_MCP_HOST=0.0.0.0
# DATASEARCHER_MCP_PORT=8000
