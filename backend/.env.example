# ── LLM Configuration ────────────────────────
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:14b

# ── Auth / Security ──────────────────────────
# REQUIRED: Set a strong random secret for JWT signing
JWT_SECRET=

# REQUIRED: Fernet key for encrypting DB connection strings
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Admin Account ────────────────────────────
# Default admin credentials (generated randomly if not set)
ADMIN_EMAIL=admin@datasearcher.com
ADMIN_PASSWORD=

# ── Application Settings ─────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100
SESSION_TTL_MINUTES=60
DUCKDB_MEMORY_LIMIT=2GB

# ── Connection Modes (enterprise) ───────────
# auto    — SQL в source DB, ML в DuckDB (по умолчанию)
# remote  — всё SQL в source DB
# dump    — выгрузить таблицы в DuckDB
# federated — кросс-БД JOIN через DuckDB extensions
DEFAULT_MODE=auto
# Таймаут remote SQL (сек), 0 = без лимита
QUERY_TIMEOUT=60
# Авто-трансляция DuckDB SQL → диалект source DB через sqlglot
AUTO_TRANSLATE=true
DUCKDB_EXTENSIONS=postgres_scanner,mysql_scanner,sqlite_scanner

# ── Read-only guard (enterprise) ─────────────
# Блокировка DML/DDL в sql_query (INSERT/UPDATE/DELETE/DROP/...)
READ_ONLY=true
# Заблокированные паттерны таблиц (glob, через запятую)
BLOCKED_TABLE_PATTERNS=raw_*,stg_*,tmp_*,_*,test_*

# ── PII masking (enterprise) ────────────────
# Авто-детекция + маскирование email/телефон/ИНН/СНИЛС/паспорт/карта/IP
PII_MASKING=true
PII_SCAN_ROWS=10

# ── Rate limiting (enterprise) ───────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SQL=60
RATE_LIMIT_ML=10

# ── Logging / Audit (enterprise) ──────────────
LOG_ENABLED=true
LOG_DB_PATH=
KB_DB_PATH=

# ── Knowledge Base sources (enterprise) ──────
DBT_MANIFEST_PATH=
DATAHUB_URL=
DATAHUB_TOKEN=

# ── Example Store + Semantic search ──────────
EXAMPLE_STORE_ENABLED=true
SEMANTIC_SEARCH_MAX_ROWS=10000
EMBEDDINGS_DIR=
